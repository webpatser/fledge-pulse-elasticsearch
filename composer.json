{
    "name": "webpatser/fledge-pulse-elasticsearch",
    "description": "Elasticsearch storage driver for Fledge Pulse: entries in a data stream with ILM retention, fiber-async reads and bulk writes.",
    "keywords": [
        "laravel",
        "fledge",
        "pulse",
        "elasticsearch"
    ],
    "homepage": "https://github.com/webpatser/fledge-pulse-elasticsearch",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/webpatser/fledge-pulse-elasticsearch/issues",
        "source": "https://github.com/webpatser/fledge-pulse-elasticsearch"
    },
    "authors": [
        {
            "name": "Christoph Kempen",
            "email": "christoph@downsized.nl"
        }
    ],
    "require": {
        "php": "^8.5",
        "elasticsearch/elasticsearch": "^8.17",
        "webpatser/fledge-fiber": "^13.36.0.3",
        "webpatser/fledge-pulse": "^1.8.1.0"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Fledge\\Pulse\\Elasticsearch\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Fledge\\Pulse\\Elasticsearch\\Tests\\": "tests/",
            "Laravel\\Pulse\\Tests\\Contract\\": "vendor/webpatser/fledge-pulse/tests/Contract/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Fledge\\Pulse\\Elasticsearch\\ElasticsearchServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        },
        "preferred-install": {
            "webpatser/fledge-pulse": "source",
            "*": "dist"
        },
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "test": [
            "@php vendor/bin/pest"
        ]
    }
}
